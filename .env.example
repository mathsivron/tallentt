# Copy this to .env for local `vercel dev`, and add the same keys in
# Vercel → Project → Settings → Environment Variables for deploys.
# Never commit the real .env file.

# Neon pooled connection string (Neon dashboard → Connection Details → Pooled connection)
DATABASE_URL=postgresql://user:password@your-pooler-host/dbname?sslmode=require&channel_binding=require

# Any long random string — used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
